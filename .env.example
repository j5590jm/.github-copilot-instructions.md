# Execution safety
TRADING_MODE=BACKTEST
ENABLE_LIVE_TRADING=false
SUPPORTED_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT

# Leave blank for backtesting. Set only in your local .env file when required.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Storage and logging
LOG_LEVEL=INFO
DATABASE_PATH=data/trading.db
DATA_DIRECTORY=data
MODEL_DIRECTORY=models

# Network timeouts (seconds)
NETWORK_CONNECT_TIMEOUT_SECONDS=5
NETWORK_READ_TIMEOUT_SECONDS=10
NETWORK_WRITE_TIMEOUT_SECONDS=10
NETWORK_POOL_TIMEOUT_SECONDS=5

# Freshness thresholds (seconds)
MARKET_DATA_STALE_AFTER_SECONDS=30
EXCHANGE_METADATA_STALE_AFTER_SECONDS=300
ACCOUNT_STATE_STALE_AFTER_SECONDS=60

# Risk and ML thresholds
MAX_ORDER_NOTIONAL=1000.00
MAX_DAILY_TRADE_COUNT=100
MAX_SLIPPAGE_BPS=25
ML_MIN_PREDICTION_CONFIDENCE=0.60
ML_MIN_VALIDATION_SCORE=0.50